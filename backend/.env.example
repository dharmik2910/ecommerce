# Database (Use DATABASE_URL for Railway PostgreSQL, or individual DB_* variables for local dev)
# DATABASE_URL=postgresql://postgres:password@host:5432/railway
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=furniture_store
DB_SSL=false

# App Settings
PORT=4000
NODE_ENV=production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS (Frontend Vercel URL, comma-separated for multiple, or * for all)
FRONTEND_URL=https://your-frontend-app.vercel.app
